{
  "name": "qqmusic-api-node",
  "version": "0.1.0",
  "description": "QQ Music API for Node.js (JavaScript port of L-1124/QQMusicApi)",
  "type": "module",
  "main": "src/server.ts",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "dev:open": "node --watch src/server.ts --open",
    "help": "node src/server.ts --help",
    "typecheck": "tsc --noEmit",
    "build:web": "npm --prefix web run build",
    "test": "node --test"
  },
  "keywords": [
    "qqmusic",
    "api",
    "nodejs"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.7",
    "flac-tagger": "^2.1.0",
    "node-id3": "^0.2.9",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
